{
  "name": "ar-realestate-backend",
  "version": "1.0.0",
  "description": "Backend API for AR Real Estate Webapp",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec node --loader ts-node/esm src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node --loader ts-node/esm prisma/seed.ts"
  },
  "keywords": [
    "real-estate",
    "augmented-reality",
    "api"
  ],
  "author": "valeso",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "@prisma/client": "^5.2.0",
    "multer": "^1.4.5-lts.1",
    "aws-sdk": "^2.1480.0",
    "socket.io": "^4.7.2",
    "redis": "^4.6.10",
    "bull": "^4.11.4",
    "validator": "^13.11.0",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.5.9",
    "@types/jest": "^29.5.5",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/bcryptjs": "^2.4.4",
    "@types/multer": "^1.4.9",
    "typescript": "^5.2.2",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.49.0",
    "@typescript-eslint/eslint-plugin": "^6.7.2",
    "@typescript-eslint/parser": "^6.7.2",
    "prettier": "^3.0.3",
    "prisma": "^5.2.0"
  }
}
